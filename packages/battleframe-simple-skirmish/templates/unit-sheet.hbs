<form class="battleframe-simple-skirmish sheet unit">
  <div class="unit-stats">
    <label>{{localize "battleframe-simple-skirmish.fields.models"}}
      <input type="number" name="system.models" value="{{system.models}}" min="0" step="1" />
    </label>
    <label>{{localize "battleframe-simple-skirmish.fields.move"}}
      <input type="number" name="system.move" value="{{system.move}}" min="0" step="1" />
    </label>
    <label class="stat-save">{{localize "battleframe-simple-skirmish.fields.save"}}
      <input type="number" name="system.save" value="{{system.save}}" min="1" max="6" step="1" />
    </label>
    <label class="stat-attack">{{localize "battleframe-simple-skirmish.fields.attackMelee"}}
      <input type="number" name="system.attackMelee" value="{{system.attackMelee}}" min="1" max="6" step="1" />
    </label>
    <label class="stat-attack">{{localize "battleframe-simple-skirmish.fields.attackRanged"}}
      <input type="number" name="system.attackRanged" value="{{system.attackRanged}}" min="1" max="6" step="1" />
    </label>
    <label class="stat-attack">{{localize "battleframe-simple-skirmish.fields.attackMagic"}}
      <input type="number" name="system.attackMagic" value="{{system.attackMagic}}" min="1" max="6" step="1" />
    </label>
    <label class="stat-skill">{{localize "battleframe-simple-skirmish.fields.skill"}}
      <input type="number" name="system.skill" value="{{system.skill}}" min="1" max="6" step="1" />
    </label>
  </div>
</form>
