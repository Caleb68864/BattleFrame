<div class="battleframe-simple-skirmish sheet unit bf-plate">
  <header class="bf-plate__header">
    <span class="bf-crest" aria-hidden="true"></span>
    <h1 class="bf-plate__name">{{actor.name}}</h1>
  </header>

  <section class="bf-section">
    <h2 class="bf-section__title">{{localize "battleframe-simple-skirmish.sections.muster"}}</h2>
    <div class="bf-devices">
      <label class="bf-device bf-device--models">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.fields.models"}}</span>
        <input class="bf-device__value" type="number" name="system.models"
               value="{{system.models}}" min="0" step="1" />
      </label>
      <label class="bf-device bf-device--move">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.fields.move"}}</span>
        <input class="bf-device__value" type="number" name="system.move"
               value="{{system.move}}" min="0" step="1" />
      </label>
    </div>
  </section>

  <section class="bf-section">
    <h2 class="bf-section__title">{{localize "battleframe-simple-skirmish.sections.attacks"}}</h2>
    <div class="bf-devices">
      <label class="bf-device bf-device--attack bf-device--melee">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.attackTypes.melee"}}</span>
        <input class="bf-device__value" type="number" name="system.attackMelee"
               value="{{system.attackMelee}}" min="1" max="6" step="1" />
      </label>
      <label class="bf-device bf-device--attack bf-device--ranged">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.attackTypes.ranged"}}</span>
        <input class="bf-device__value" type="number" name="system.attackRanged"
               value="{{system.attackRanged}}" min="1" max="6" step="1" />
      </label>
      <label class="bf-device bf-device--attack bf-device--magic">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.attackTypes.magic"}}</span>
        <input class="bf-device__value" type="number" name="system.attackMagic"
               value="{{system.attackMagic}}" min="1" max="6" step="1" />
      </label>
    </div>
  </section>

  <section class="bf-section">
    <h2 class="bf-section__title">{{localize "battleframe-simple-skirmish.sections.defence"}}</h2>
    <div class="bf-devices">
      <label class="bf-device bf-device--save">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.fields.save"}}</span>
        <input class="bf-device__value" type="number" name="system.save"
               value="{{system.save}}" min="1" max="6" step="1" />
      </label>
      <label class="bf-device bf-device--skill">
        <span class="bf-device__icon" aria-hidden="true"></span>
        <span class="bf-device__label">{{localize "battleframe-simple-skirmish.fields.skill"}}</span>
        <input class="bf-device__value" type="number" name="system.skill"
               value="{{system.skill}}" min="1" max="6" step="1" />
      </label>
    </div>
  </section>
</div>
