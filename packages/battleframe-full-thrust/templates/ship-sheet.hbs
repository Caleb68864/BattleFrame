{{!-- Full Thrust ship SSD. ApplicationV2 supplies the <form> root; do not wrap. --}}
<div class="ft-ship-sheet">
  <section class="ft-core">
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.mass"}}</label>
      <input type="number" name="system.mass" value="{{system.mass}}" min="1" step="1" />
    </div>
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.thrust"}}</label>
      <input type="number" name="system.thrust" value="{{system.thrust}}" min="0" max="8" step="1" />
      <span class="ft-track-now" title="usable / design">{{system.thrustTrack}}</span>
    </div>
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.fcs"}}</label>
      <input type="number" name="system.fcs" value="{{system.fcs}}" min="0" step="1" />
      <span class="ft-track-now" title="remaining / design">{{system.fcsTrack}}</span>
    </div>
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.screens"}}</label>
      <input type="number" name="system.screens" value="{{system.screens}}" min="0" max="3" step="1" />
      <span class="ft-track-now" title="remaining / design">{{system.screensTrack}}</span>
    </div>
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.pds"}}</label>
      <input type="number" name="system.pds" value="{{system.pds}}" min="0" step="1" />
      <span class="ft-track-now" title="remaining / design">{{system.pdsTrack}}</span>
    </div>
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.ftl"}}</label>
      <input type="checkbox" name="system.ftl" {{#if system.ftl}}checked{{/if}} />
    </div>
    <div class="ft-field ft-points">
      <label>{{localize "battleframe-full-thrust.fields.points"}}</label>
      <span>{{system.pointsValue}}</span>
    </div>
  </section>

  <section class="ft-track">
    <h3>{{localize "battleframe-full-thrust.fields.armour"}}</h3>
    <div class="ft-hull-track ft-armour-track" title="{{localize "battleframe-full-thrust.armour.trackHint"}}">
      {{#each armourBoxes}}
        <button type="button" class="ft-hull-box ft-armour-box{{#if this.damaged}} ft-damaged{{/if}}"
          data-action="toggleArmourBox" data-number="{{this.number}}"
          aria-label="armour box {{this.number}}"></button>
      {{/each}}
    </div>
    <div class="ft-boxes">
      <input type="number" name="system.armour.damage" value="{{system.armour.damage}}" min="0" step="1" />
      <span>/</span>
      <input type="number" name="system.armour.boxes" value="{{system.armour.boxes}}" min="0" step="1" />
    </div>
    <h3>{{localize "battleframe-full-thrust.fields.hull"}}</h3>
    <div class="ft-hull-track" title="{{localize "battleframe-full-thrust.hull.trackHint"}}">
      {{#each hullBoxes}}
        <button type="button" class="ft-hull-box{{#if this.damaged}} ft-damaged{{/if}}"
          data-action="toggleHullBox" data-number="{{this.number}}"
          aria-label="hull box {{this.number}}"></button>
        {{#if this.rowEnd}}<span class="ft-threshold-sep" aria-hidden="true"></span>{{/if}}
      {{/each}}
    </div>
    <div class="ft-boxes">
      <input type="number" name="system.hull.damage" value="{{system.hull.damage}}" min="0" step="1" />
      <span>/</span>
      <input type="number" name="system.hull.boxes" value="{{system.hull.boxes}}" min="1" step="1" />
      <label>rows</label>
      <input type="number" name="system.hull.rows" value="{{system.hull.rows}}" min="1" step="1" />
    </div>
  </section>

  <section class="ft-movement">
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.velocity"}}</label>
      <input type="number" name="system.velocity" value="{{system.velocity}}" min="0" step="1" />
    </div>
    <div class="ft-field">
      <label>{{localize "battleframe-full-thrust.fields.course"}}</label>
      <input type="number" name="system.course" value="{{system.course}}" min="1" max="12" step="1" />
    </div>
  </section>

  <section class="ft-weapons">
    <h3>Weapons <button type="button" class="ft-add-weapon" data-action="addWeapon" title="Add weapon">+ Add</button></h3>
    <ol>
      {{#each weapons as |weapon|}}
        <li class="ft-weapon {{#if weapon.destroyed}}ft-destroyed{{/if}}">
          <select name="system.weapons.{{weapon.index}}.kind" class="ft-weapon-kind">
            {{#each weapon.kinds as |k|}}
              <option value="{{k.value}}" {{#if k.selected}}selected{{/if}}>{{k.value}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.weapons.{{weapon.index}}.weaponClass"
                 value="{{weapon.weaponClass}}" min="1" step="1" class="ft-weapon-class" placeholder="cls" />
          <select name="system.weapons.{{weapon.index}}.arcs" multiple class="ft-weapon-arcs" size="1">
            {{#each weapon.arcs as |arc|}}
              <option value="{{arc.value}}" {{#if arc.selected}}selected{{/if}}>{{arc.value}}</option>
            {{/each}}
          </select>
          <button type="button" class="ft-remove-weapon" data-action="removeWeapon"
                  data-index="{{weapon.index}}" title="Remove">&times;</button>
        </li>
      {{/each}}
    </ol>
  </section>
</div>
