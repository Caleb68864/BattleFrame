{{!-- Battleframe's generic Actor sheet -- the fallback landing pad when no
     ruleset is installed, or when a ruleset that defined this Actor's real
     type gets disabled. Renders only the generic data model's own fields.
     NB: no <form> wrapper -- the ApplicationV2 root element IS the form; a
     nested form would own the inputs and break submitOnChange. --}}
<div class="battleframe generic-actor-sheet">
  <div class="form-group">
    <label>{{localize "battleframe.fields.notes"}}</label>
    <input type="text" name="system.notes" value="{{system.notes}}">
  </div>

  <div class="form-group stacked">
    <label>{{localize "battleframe.fields.biography"}}</label>
    <prose-mirror name="system.biography" value="{{system.biography}}"></prose-mirror>
  </div>
</div>
