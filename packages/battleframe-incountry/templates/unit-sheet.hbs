<div class="battleframe-incountry sheet unit inx-dossier">
  <header class="inx-dossier__header">
    <h1 class="inx-dossier__name">{{actor.name}}</h1>
    <span class="inx-dossier__tag">{{localize "battleframe-incountry.sheet.tag"}}</span>
  </header>

  <section class="inx-block">
    <h2 class="inx-block__title">{{localize "battleframe-incountry.sheet.muster"}}</h2>
    <div class="inx-stats">
      <label class="inx-stat">
        <span class="inx-stat__label">{{localize "battleframe-incountry.sheet.models"}}</span>
        <span class="inx-stat__pair">
          <input type="number" name="system.modelsRemaining" value="{{system.modelsRemaining}}" min="0" step="1" />
          <span class="inx-stat__sep">/</span>
          <input type="number" name="system.modelCount" value="{{system.modelCount}}" min="1" step="1" />
        </span>
      </label>
      <label class="inx-stat">
        <span class="inx-stat__label">{{{localize "battleframe-incountry.sheet.move"}}}</span>
        <input type="number" name="system.move" value="{{system.move}}" min="0" step="1" />
      </label>
      <label class="inx-stat">
        <span class="inx-stat__label">{{localize "battleframe-incountry.sheet.morale"}}</span>
        <input type="number" name="system.morale" value="{{system.morale}}" min="0" step="1" />
      </label>
    </div>
  </section>

  <section class="inx-block">
    <h2 class="inx-block__title">{{{localize "battleframe-incountry.sheet.attackArmor"}}}</h2>
    <div class="inx-stats">
      <label class="inx-stat inx-stat--attack">
        <span class="inx-stat__label">{{localize "battleframe-incountry.sheet.clear"}}</span>
        <input type="number" name="system.attackClear" value="{{system.attackClear}}" min="0" step="1" />
      </label>
      <label class="inx-stat inx-stat--attack">
        <span class="inx-stat__label">{{localize "battleframe-incountry.sheet.inCover"}}</span>
        <input type="number" name="system.attackCover" value="{{system.attackCover}}" min="0" step="1" />
      </label>
      <label class="inx-stat inx-stat--armor">
        <span class="inx-stat__label">{{localize "battleframe-incountry.sheet.armorModifier"}}</span>
        <input type="number" name="system.armorModifier" value="{{system.armorModifier}}" min="0" step="1" />
        <span class="inx-stat__rating" title="{{localize "battleframe-incountry.sheet.armorRatingHint"}}">{{armorRating}}</span>
      </label>
      <label class="inx-stat inx-stat--armor">
        <span class="inx-stat__label">{{localize "battleframe-incountry.sheet.armorDice"}}</span>
        <input type="number" name="system.armorDice" value="{{system.armorDice}}" min="0" step="1" />
      </label>
    </div>
    <label class="inx-toggle">
      <input type="checkbox" name="system.suppressed" {{#if system.suppressed}}checked{{/if}} />
      <span>{{localize "battleframe-incountry.sheet.suppressed"}}</span>
    </label>
  </section>

  <section class="inx-block">
    <h2 class="inx-block__title">
      {{localize "battleframe-incountry.sheet.weapons"}}
      <button type="button" class="inx-add" data-action="addWeapon" title="{{localize "battleframe-incountry.sheet.addWeaponHint"}}"><i class="fas fa-plus"></i> {{localize "battleframe-incountry.sheet.add"}}</button>
    </h2>
    <div class="inx-weapons">
      <div class="inx-weapons__head">
        <span>{{localize "battleframe-incountry.sheet.colWeapon"}}</span><span>{{localize "battleframe-incountry.sheet.colCount"}}</span><span>{{localize "battleframe-incountry.sheet.colDmg"}}</span><span>{{localize "battleframe-incountry.sheet.colAttack"}}</span><span>{{localize "battleframe-incountry.sheet.colOverwatch"}}</span><span></span>
      </div>
      {{#each system.weapons as |weapon i|}}
      <div class="inx-weapon">
        <input type="text" name="system.weapons.{{i}}.name" value="{{weapon.name}}" />
        <input type="number" name="system.weapons.{{i}}.count" value="{{weapon.count}}" min="0" step="1" />
        <input type="number" name="system.weapons.{{i}}.dmg" value="{{weapon.dmg}}" min="0" step="1" />
        <input type="number" name="system.weapons.{{i}}.attackDice" value="{{weapon.attackDice}}" min="0" step="1" title="{{localize "battleframe-incountry.sheet.attackDiceHint"}}" />
        <input type="number" name="system.weapons.{{i}}.owDice" value="{{weapon.owDice}}" min="0" step="1" title="{{localize "battleframe-incountry.sheet.owDiceHint"}}" />
        <button type="button" class="inx-remove" data-action="removeWeapon" data-index="{{i}}" title="{{localize "battleframe-incountry.sheet.removeHint"}}"><i class="fas fa-trash"></i></button>
      </div>
      {{else}}
      <p class="inx-weapons__empty">{{localize "battleframe-incountry.sheet.noWeapons"}}</p>
      {{/each}}
    </div>
  </section>
</div>
